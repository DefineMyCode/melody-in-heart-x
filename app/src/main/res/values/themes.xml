<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      App theme. parent is the light Material base here (values/); values-night/ overrides the
      parent with the dark Material base so the launch window follows the system dark mode.
      windowBackground is pinned to the monochrome palette to avoid a white first frame.
      (No custom SplashScreen: launch goes straight into the app; Android 12+ shows the system
      default splash over this windowBackground.)
    -->
    <style name="Theme.Melody" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
