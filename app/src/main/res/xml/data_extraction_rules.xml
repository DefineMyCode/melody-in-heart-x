<?xml version="1.0" encoding="utf-8"?>
<!-- Device-to-device / cloud extraction rules (plan P4-8 / P0-9). Mirrors backup_rules.xml: the
     Room database, DataStores and URI grants are local-only and must not be transferred to
     another device. The album-art cache lives in the app cache dir, which is never transferred
     by default, so no explicit exclude is needed (and the cache domain is not a valid exclude
     target for FullBackupContent). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="melody" />
        <exclude domain="database" path="melody-wal" />
        <exclude domain="database" path="melody-shm" />
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="androidx.core.content.FileProvider" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="melody" />
        <exclude domain="database" path="melody-wal" />
        <exclude domain="database" path="melody-shm" />
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="androidx.core.content.FileProvider" />
    </device-transfer>
</data-extraction-rules>
