        <exclude domain="file" path="datastore/playback_state.preferences_pb" />
        <exclude domain="file" path="album_art_cache/" />
        <exclude domain="file" path="album_art/" />
        <exclude domain="file" path="cache/album_art/" />
    </device-transfer>
</data-extraction-rules>
