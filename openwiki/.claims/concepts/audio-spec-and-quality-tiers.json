  "claims": [
    {
      "id": "claim_f8be0afb2fa54ba38395f0c64a23a5b4",
      "statement": "AudioQualityTier.classify grades lossy codecs by bitrate alone: >=320 kbps is VERY_HIGH, >=192 HIGH, >0 STANDARD, and 0 UNKNOWN; lossless codecs are graded by bit depth and sample rate instead.",
      "evidence": [
        {
          "resource": "repo://core/model/src/main/java/cn/com/dcsgo/mihx/core/model/AudioQualityTier.kt#L69-L93",
          "version": "repo-lines-v1:sha256:2fdf908ee017dd74056bc925dbff6e7afde15f0f1aadf22945a899075422fd6a:"
        }
      ]
    },
    {
      "id": "claim_8b71e840982c4adea4f775bce173d6a1",
      "statement": "For lossless codecs, classify returns HI_RES when bitDepth >= 24 and sampleRate >= 48000, LOSSLESS when bitDepth >= 16 and sampleRate >= 44100 (or when bitDepth is 0 but sampleRate >= 44100), and UNKNOWN otherwise; DSD MIMEs (audio/dsd, audio/x-dsd) short-circuit to HI_RES regardless of depth or sample rate.",
      "evidence": [
        {
          "resource": "repo://core/model/src/main/java/cn/com/dcsgo/mihx/core/model/AudioQualityTier.kt#L69-L93",
          "version": "repo-lines-v1:sha256:2fdf908ee017dd74056bc925dbff6e7afde15f0f1aadf22945a899075422fd6a:"
        },
        {
          "resource": "repo://core/model/src/test/java/cn/com/dcsgo/mihx/core/model/AudioQualityTierTest.kt#L21-L34",
          "version": "repo-lines-v1:sha256:0efcde2ca4c6e699bc04f97e64e99c3a807aceca7d61e6d747b960bcfefcbcff:"
        }
      ]
    },
    {
      "id": "claim_f6af5d1d8d844e55aec5a2afcb1ac3f1",
      "statement": "Losslessness is decided by a fixed MIME allow-list (audio/flac, x-flac, alac, x-alac, raw, wav, x-wav, aiff, x-aiff, ape, x-ape, dsd, x-dsd) exposed as AudioQualityTier.isLossless, not by file extension or container.",
      "evidence": [
        {
          "resource": "repo://core/model/src/main/java/cn/com/dcsgo/mihx/core/model/AudioQualityTier.kt#L22-L41",
          "version": "repo-lines-v1:sha256:f29a80ba8a41bdcc1334ac75a06ba24510d18cbc566a3d0a4a217f567ad9aa59:"
        }
      ]
    },
