    {
      "id": "claim_c3a35df534d14c92a6bfe2d9b7f7eed7",
      "statement": "MoodSlotPolicy centralizes the tunable thresholds: POOL_WARN_THRESHOLD = 10 (small-pool warning), MATCH_MIN_RATIO = 0.35f (a slot tag only counts a song as a hit when the word's fraction of the whole song is ≥ this; user manual tags count as 1.0 and always match), NAME_MAX_LENGTH = 20 (name validation), and MAX_SLOTS = 10, which is a soft per-user limit not enforced by any code path.",
      "evidence": [
