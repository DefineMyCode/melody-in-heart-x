  "claims": [
    {
      "id": "claim_9b279a6b7c1843adb24a3cd91eaa4fca",
      "statement": "TimeSlotConfig models a slot as flat fields (id, name, startMinutes, endMinutes, tags) with half-open [start, end) minutes-of-day semantics: endMinutes <= startMinutes means a cross-midnight slot covering [start, 24:00) ∪ [0, end), start == end is zero-length and illegal, and covers() normalizes minuteOfDay modulo 1440 before testing.",
      "evidence": [
        {
          "resource": "repo://core/model/src/main/java/cn/com/dcsgo/mihx/core/model/TimeSlotConfig.kt#L16-L48",
          "version": "repo-lines-v1:sha256:51464222fb53191f9964e51edcd9ca7bda5d952b9b3dd12d099639130146751a:"
        }
      ]
    },
    {
      "id": "claim_b165b36ef4dd41e48d708afe2844389d",
      "statement": "MoodSlotResolver.hitSlot selects the covering slot with covers() and minByOrNull(startMinutes), so valid (pairwise non-overlapping) configs hit at most one slot per minute and invalid multi-hit data resolves deterministically to the earliest-start slot; activeTags returns null when the switch is off, configs are empty, or no slot covers the minute, otherwise the hit slot's tag set.",
      "evidence": [
        {
          "resource": "repo://domain/src/main/java/cn/com/dcsgo/mihx/domain/playback/MoodSlotResolver.kt#L30-L49",
          "version": "repo-lines-v1:sha256:0615917a3a12e1836621d1c8fd89633a7156e286ca4341af90c4e6bad89724d8:"
        }
      ]
    },
