    {
      "id": "claim_09a78c1aefc94e35b6a95298e77a4002",
      "statement": "RandomQueuePlanner batches by neededSize = minOf(DEFAULT_BATCH_SIZE=20, playable pool size), excludes recentSongIds from selection, and when the remainder falls below the batch it clears the recent set (resetHistory=true) and reuses the whole pool; trimToLimit caps the returned recent set to the playable library size, dropping earliest-inserted ids first. With uniform random off the selection is shuffle(pool).take(batch) shuffled again.",
      "evidence": [
        {
          "resource": "repo://domain/src/main/java/cn/com/dcsgo/mihx/domain/playback/RandomQueuePlanner.kt#L135-L143",
          "version": "repo-lines-v1:sha256:f507c3c567059855f711614fe3b98a89379dd660b05689f773f49485df18d751:"
