    {
      "id": "claim_8f97ded1f5484973a32f2a0bff045509",
      "statement": "Restore-after-rebuild decisions converge only after the MediaController connects: PlayerPersistenceGraph gates maybeApplyRestore on both controllerReady (set by onControllerReady after connect's first snapshot sync) and a pendingRestore read on IO in parallel with the connection, and uses controller queue non-emptiness (mediaItemCount > 0) as the sole live-session criterion; guessing from position or queueInfo before connect races because currentPlaybackPositionMs degrades to the fresh UI value (always 0) and would overwrite the playing session with the snapshot.",
      "evidence": [
        {
          "resource": "repo://feature/player/src/main/java/cn/com/dcsgo/mihx/feature/player/PlayerPersistenceGraph.kt#L50-L111",
          "version": "repo-lines-v1:sha256:d8e3db31ddf2585d518d0edbba1854bbcd24fdd277ee906c9208eaf8c3f4f4b7:"
