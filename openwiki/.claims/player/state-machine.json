  "claims": [
    {
      "id": "claim_c2943af13c8048efb46050644cae10e4",
      "statement": "Playback state ownership is layered: AppMediaSessionService owns ExoPlayer/MediaSession and persists exit snapshots; PlaybackController translates Media3 callbacks into ControllerPlaybackSnapshot and transport commands; ControllerPlaybackStateSynchronizer maps controller snapshots into app playback state; feature facades (PlayerControllerStateFacade and peers) update PlayerUiState, tracking, and persistence; UI only renders PlayerUiState and must not infer Media3 state directly.",
      "evidence": [
        {
          "resource": "repo://docs/architecture/PLAYBACK_STATE_MACHINE.md#L5-L13",
          "version": "repo-lines-v1:sha256:da6ebaa1565b7fcb363e483e76eb32a96540b9f0ce11ccab64654397fffea627:"
        },
        {
          "resource": "repo://feature/player/src/main/java/cn/com/dcsgo/mihx/feature/player/PlayerViewModel.kt#L23-L31",
