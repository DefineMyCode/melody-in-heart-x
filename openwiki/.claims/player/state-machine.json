    {
      "id": "claim_1a5f9903e5ef41efb3bc3daa946aa3a3",
      "statement": "Any path that flips isPlaying must emit the onIsPlayingChanged notification or the progress ticker never starts and progress stays 0 while audio plays; syncControllerPlaybackState re-emits the notification only when wasPlaying differs from the synced state — the guard is mandatory because PlaybackController.listener.onEvents wires onPlaybackSnapshot as a high-frequency per-event-batch callback — and this re-emit is the only way a live session (fresh UI state plus a new MediaController that Media3 does not backfill with onIsPlayingChanged) starts the ticker, which writes a real position immediately upon starting.",
      "evidence": [
        {
          "resource": "repo://feature/player/src/main/java/cn/com/dcsgo/mihx/feature/player/PlayerControllerStateFacade.kt#L40-L52",
