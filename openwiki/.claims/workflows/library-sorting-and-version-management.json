    {
      "id": "claim_64db4702ed3f486eb218eddf97965b76",
      "statement": "Song.groupKey is derived, never stored: the default key is title + U+0001 + artist + U+0001 + album (Song.GROUP_KEY_SEPARATOR), a non-null titleOverride replaces it entirely — a manual reassign stores the target group's full groupKey so the song joins that group, and a detach stores \"title#id\" via SongVersionManager.detachedGroupKey so the song forms a one-song group. groupKeyLabel renders the target's title for a reassigned song, the song's own title for a detached or unmodified song, and isDetachedFromGroup is true only for the \"title#id\" form; grouping never renames Song.title or any other metadata.",
      "evidence": [
        {
          "resource": "repo://core/model/src/main/java/cn/com/dcsgo/mihx/core/model/Song.kt#L96-L130",
          "version": "repo-lines-v1:sha256:0731122276c2196a28420f809b0bf6c255905e6cb633eeee0962b840310f6cf5:"
        },
