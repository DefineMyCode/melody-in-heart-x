  "claims": [
    {
      "id": "claim_c01257f430474bcf937e812665d3fbc4",
      "statement": "The local-music sort setting is persisted in the player_settings DataStore as two orthogonal keys: song_sort_mode stores SongSortMode.name and song_sort_ascending is a separate boolean defaulting to true. Reading normalizes the retired value \"SAMPLE_RATE\" to BIT_RATE and otherwise matches SongSortMode.entries, falling back to IMPORT_ORDER, while writes only ever store mode.name — so the SAMPLE_RATE→BIT_RATE replacement needs no Room migration and no new preference key.",
      "evidence": [
        {
          "resource": "repo://data/src/main/java/cn/com/dcsgo/mihx/data/repository/PlayerSettingsDataStore.kt#L53-L53",
          "version": "repo-lines-v1:sha256:850ab869bc3b19c9d240e93aa7c4f5f2bf5ccf1a76ebe4dbed735f253e0338c6:"
        },
