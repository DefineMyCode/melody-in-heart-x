    {
      "id": "claim_bc25c4493b4542d58998c0fb4e391242",
      "statement": "SongVersionComparer.compare sorts versions by sampleRate descending, always emits the 格式 and 采样率 rows, gates 位深 / 音质 / 声道 / 空间音频 / 比特率 / 文件大小 on at least one version carrying that data, then always appends 时长 / 艺术家 / 专辑 / 歌词 / 封面; rows whose cells have more than one distinct display string become the diff table (rows) while identical rows collapse into commonFields as label-to-value pairs ordered by FIELD_ORDER with unknown labels last.",
      "evidence": [
        {
          "resource": "repo://domain/src/main/java/cn/com/dcsgo/mihx/domain/playback/SongVersionComparer.kt#L235-L239",
          "version": "repo-lines-v1:sha256:0df623590fe37cd8880bfd83a8df7108335178a2173ef4afca5f51633438d7b7:"
