    {
      "id": "claim_ab2f8947abc542eeb0ff1a5fcb182369",
      "statement": "SongSorter.sort maps each of the eight SongSortMode values to one comparator: IMPORT_ORDER=id, TITLE=groupKey, ARTIST=first parsed artist then groupKey, ALBUM=album then groupKey, DURATION=durationMs, BIT_RATE=bitRateKbps, PLAY_COUNT=playCounts[id] else 0 then id, LAST_PLAYED=lastPlayedAt[id] else 0 then id; string fields compare through a single Collator.getInstance(Locale.CHINA), and descending direction is produced by reversing the comparator (reversing the id tiebreak too) rather than reversing the output list.",
      "evidence": [
        {
          "resource": "repo://core/model/src/main/java/cn/com/dcsgo/mihx/core/model/Song.kt#L90-L94",
          "version": "repo-lines-v1:sha256:efbd48c73c5d603c01d972b877532ad92b5282ee98933f7e922f4099ea2b2aa9:"
