<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- :player is the Media3 playback kernel and intentionally uses Media3 @UnstableApi APIs
         (e.g. AppMediaSessionService, which extends the opt-in MediaSessionService). Opt in
         project-wide so lint's UnsafeOptInUsageError no longer fires on every usage.

         NOTE: this is a per-module opt-in (only affects :player's lint). :feature:player does
         NOT reference AppMediaSessionService directly, so it stays opt-in-free. The Kotlin
         compiler still requires @OptIn(UnstableApi::class) at the actual usage sites (e.g.
         PlaybackController.startSessionService), which remains in the source. -->
    <issue id="UnsafeOptInUsageError">
        <option name="opt-in" value="androidx.media3.common.util.UnstableApi" />
    </issue>
</lint>
